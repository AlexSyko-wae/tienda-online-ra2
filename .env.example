# Copia este archivo a .env y cambia las dos claves privadas antes de usar Compose.
# Compose lee .env; Django local lee variables del sistema.
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-unica-y-privada
DB_ENGINE=mysql
DB_NAME=tienda_online_ra2
DB_USER=root
DB_PASSWORD=escribir-solo-en-tu-equipo
DB_HOST=localhost
DB_PORT=3306
# Solo para la práctica local; restringe los hosts al publicar la aplicación.
DJANGO_ALLOWED_HOSTS=*
